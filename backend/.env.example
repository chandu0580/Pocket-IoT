# PocketIoT Environment Configuration

# Database Configuration
# For SQLite: sqlite:///backend/iot_data.db
# For PostgreSQL: postgresql://user:password@localhost:5432/pocketiot
DATABASE_URL=sqlite:///backend/iot_data.db

# Security
JWT_SECRET=your_super_secret_jwt_key_here
PORT=5000

# Frontend Configuration (for CORS or redirection if needed)
API_BASE_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000
